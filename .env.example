# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (NO SENSITIVE SECRETS)
# ==============================================================================
# Copy this file to .env for local testing or configure these in Netlify:
# Site Configuration > Environment variables

# 1. Cryptographic HMAC Key for Altcha PoW Verification
# Generate a cryptographically strong 32+ byte string (e.g., openssl rand -hex 32)
ALTCHA_HMAC_KEY=

# 2. Nodemailer SMTP Configuration
# Gmail address used for authenticating and sending notifications
EMAIL_USER=

# Gmail 16-character App Password (Do NOT use account password)
EMAIL_PASS=

# 3. Notification Recipient
# To preserve the Gmail -> Proton forwarding workflow, leave this BLANK (or set to your EMAIL_USER address).
# When blank, notifications are sent directly to your Gmail inbox (EMAIL_USER), which then forwards them to Proton.
# (Only specify a recipient here if you want to override the Gmail inbox destination).
NOTIFICATION_EMAIL=
